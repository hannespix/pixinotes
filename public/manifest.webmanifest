{
  "id": "/pixinotes/",
  "name": "PixiNotes – Whiteboard, Notizen & Projekte",
  "short_name": "PixiNotes",
  "description": "Lokales Whiteboard mit Notizen, Kanban, Zeitplänen, Kalender und KI – alle Daten bleiben in deinem Browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f4f6",
  "theme_color": "#f3f4f6",
  "lang": "de",
  "categories": ["productivity", "business"],
  "share_target": {
    "action": "./teilen-ziel",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "text": "text",
      "url": "adresse",
      "files": [
        {
          "name": "dateien",
          "accept": ["image/*", "application/pdf", "text/*", "message/rfc822", "text/calendar",
            ".eml", ".msg", ".ics", ".csv", ".md", ".txt", ".json", ".docx", ".xlsx"]
        }
      ]
    }
  },
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "./screenshots/uebersicht-breit.webp", "sizes": "1280x800", "type": "image/webp", "form_factor": "wide", "label": "Übersicht mit Bereichen, Projekten und Boards" },
    { "src": "./screenshots/uebersicht-schmal.webp", "sizes": "450x800", "type": "image/webp", "form_factor": "narrow", "label": "Übersicht am Telefon" }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "https://hannespix.github.io/pixinotes/manifest.webmanifest" }
  ],
  "prefer_related_applications": false
}
