{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "PixiNotes",
  "description": "__MSG_beschreibung__",
  "version": "1.0.0",
  "default_locale": "de",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "__MSG_knopf__",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "hintergrund.js", "scripts": ["hintergrund.js"] },
  "options_ui": { "page": "optionen.html", "open_in_tab": false },
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["https://hannespix.github.io/pixinotes/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "121",
  "browser_specific_settings": { "gecko": { "id": "pixinotes-senden@hannespix.github.io", "strict_min_version": "128.0" } }
}
