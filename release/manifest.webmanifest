{
  "name": "PixiNotes — Whiteboard, Notizen & Projekte",
  "short_name": "PixiNotes",
  "description": "Lokales Whiteboard mit Notizen, Kanban, Zeitplänen, Kalender und KI — alle Daten bleiben in deinem Browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f2ea",
  "theme_color": "#4f7cff",
  "lang": "de",
  "share_target": {
    "action": "./teilen-ziel",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "text": "text",
      "url": "adresse",
      "files": [
        {
          "name": "dateien",
          "accept": ["image/*", "application/pdf", "text/*", "message/rfc822", "text/calendar",
            ".eml", ".msg", ".ics", ".csv", ".md", ".txt", ".docx", ".xlsx", ".pixinotes.json"]
        }
      ]
    }
  },
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
